/*
 * native_sim ja tem led0 (gpio0 pino 0). Mais dois LEDs no mesmo
 * controlador emulado, so para a demonstracao ter tres ritmos.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led1 = &app_led1;
		led2 = &app_led2;
	};

	app_leds {
		compatible = "gpio-leds";

		app_led1: led_1 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LED 1";
		};

		app_led2: led_2 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "LED 2";
		};
	};
};
