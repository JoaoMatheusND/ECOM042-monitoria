menu "Modulo de LED"

config LED_MAX_ALIASES
	int "Quantidade maxima de aliases ledN procurados no devicetree"
	default 8
	range 1 16
	help
	  O modulo procura led0, led1, ..., led(N-1) no devicetree e usa
	  todos os que existirem.

config LED_BLINK_SLOW_PERIOD_MS
	int "Periodo do pisca lento (ms)"
	default 1000
	range 2 60000
	help
	  Periodo completo (aceso + apagado) do padrao lento.

config LED_BLINK_NORMAL_PERIOD_MS
	int "Periodo do pisca padrao (ms)"
	default 500
	range 2 60000
	help
	  Periodo completo (aceso + apagado) do padrao normal.

config LED_BLINK_FAST_PERIOD_MS
	int "Periodo do pisca rapido (ms)"
	default 200
	range 2 60000
	help
	  Periodo completo (aceso + apagado) do padrao rapido.

module = LED_MODULE
module-str = led
source "subsys/logging/Kconfig.template.log_config"

endmenu
