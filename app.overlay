/*
 * O native_sim ja tem led0 no gpio emulado; led1 e led2 sao
 * adicionados nos pinos seguintes do mesmo controlador.
 */

/ {
	extra_leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "LED 1";
		};

		led2: led_2 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LED 2";
		};
	};

	aliases {
		led1 = &led1;
		led2 = &led2;
	};
};
