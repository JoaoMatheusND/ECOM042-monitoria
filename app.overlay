/*
 * Atividade-05: segundo LED no gpio0 (pino 1), exposto como led1.
 * O led0 ja vem da placa (gpio0 pino 0); o modulo enumera os filhos
 * do no gpio-leds, entao basta declarar o no e o alias.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

&leds {
	led1: led_1 {
		gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		label = "LED 1";
	};
};

/ {
	aliases {
		led1 = &led1;
	};
};
