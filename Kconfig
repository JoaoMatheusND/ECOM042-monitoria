config UART_LINE_BUF_SIZE
    int "Size of buffer (bytes)"
    default 64
    range 64 1024
    help
        Buffer size of the uart buffer transport layer. 
        Includes null terminator. Bigger lines will be ignored. 

config CMD_BUF_SIZE
    int "Size of the command response buffer (bytes)"
    default 256
    range 64 1024
    help
        Size of the buffer inside struct cmd_out, where command handlers
        write their response. Includes null terminator. Longer responses
        are truncated and flagged as overflow.

# Must stay the last line: the unit test apps include this file with rsource
# and rely on it to load Kconfig.zephyr.
source "Kconfig.zephyr"