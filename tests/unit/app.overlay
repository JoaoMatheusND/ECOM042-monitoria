#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led0 = &test_led0;
		led1 = &test_led1;
		led2 = &test_led2;
	};

	test_gpio: gpio_test {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		status = "okay";
	};

	test_leds {
		compatible = "gpio-leds";

		test_led0: test_led_0 {
			gpios = <&test_gpio 0 GPIO_ACTIVE_HIGH>;
		};

		test_led1: test_led_1 {
			gpios = <&test_gpio 1 GPIO_ACTIVE_HIGH>;
		};

		test_led2: test_led_2 {
			gpios = <&test_gpio 2 GPIO_ACTIVE_HIGH>;
		};
	};
};
